      <!-- Left side: Breadcrumb + Booking Form -->
      <div class="form-section">
        <section class="booking-form">
          <h1>Booking An Artisan</h1>
          <br>
          <!-- Fixed booking form with all required fields -->
<form id="bookingForm" method="POST" action="/booking/create">
    <!-- Hidden fields for required data -->
    <input type="hidden" name="userId" value="<%= userId || '' %>" />
    <input type="hidden" name="artisanId" value="66a123b456c789d012e34567">

    
    <label for="fullName">Full Name</label>
    <input type="text" id="fullName" name="fullName" placeholder="Enter full name" required />
    
    <label for="email">E-mail / Username</label>
    <input type="email" id="email" name="email" placeholder="Enter email address" required />
    
    <label for="phone">Phone Number</label>
    <input type="tel" id="phone" name="phone" placeholder="Enter phone number" required/>
    
    <label for="price">Expected Price (₦)</label>
    <input type="text" id="price" name="price" placeholder="Enter expected price" required/>
    
    <label for="location">Location</label>
    <input type="text" id="location" name="location" placeholder="Enter your location" required/>
    
    <label for="serviceType">Service Type</label>
    <select id="serviceType" name="serviceType" required>
        <option value="">Select Service Type</option>
        <option value="Tailoring">Tailoring</option>
        <option value="Plumbing">Plumbing</option>
        <option value="Electrical">Electrical</option>
        <option value="Carpentry">Carpentry</option>
    </select>
    
    <label for="bookingDate">Preferred Date</label>
    <input type="date" id="bookingDate" name="bookingDate" required />
    
    <label for="message">Message</label>
    <textarea id="message" name="message" placeholder="Message Subject" required></textarea>
    
    <button type="submit">Submit Booking</button>
</form>
          <!-- <p id="formStatus"></p> -->
        </section>

        <div class="vertical-line"></div>

        <!-- Right side: Profile Card -->
        <aside class="profile-card">
          <img
            src="/images/profile.jpeg"
            alt="CraftConnect Logo"
            class="profile-logo"
