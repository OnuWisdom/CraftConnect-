<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explore Artisan</title>
    <link rel="stylesheet" href="/css/exploreartisan2.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    

</head>
<body>
    <!-- Container housing the header -->
	<div id="container">
			

		<section class="section-container">
			<!-- <div class="custom-nav">
				<a href="/">Home ></a>
				<a href="">Search ></a>
				<a href="">Tailor in Lagos ></a>
				<a href="">Bisi Samuel ></a>
				<a href="" class="profile">Profile</a>
			</div> -->

			<div class="group-container">

				<div class="details-container">
					<div class="container-1">
						<img src="/images/p (2).jpg" class="artisan-image" alt="">

						<div class="details">

							<h2>Bisi Samuel</h2>
							<span>Professional Tailor</span>

							<div class="artisan-rating-container">
								<div class="artisan-rating">
									<img src="/images/Vector (9).svg" alt="">
									<img src="/images/Vector (9).svg" alt="">
									<img src="/images/Vector (9).svg" alt="">
									<img src="/images/Vector (9).svg" alt="">
									<img src="/images/Vector (9).svg" class="rating-star" alt="">
								</div>
								<span>4.0<span>( 32</span> reviews)</span>
							</div>
							
							<div class="artisan-location">
								<p>Alimosho,Lagos.</p>
							</div>
							<p>Creating custom clothing with precision and style.</p>
						</div>
					</div>
					<button class="share-profile">
						<img src="/images/majesticons_share-line.svg" alt="">
						Share profile
					</button>
					
				</div>

				<div class="button-container">
					<button class="book-artisan">Book artisan</button>
					<button class="send-message"><img src="/images/PaperPlaneRight.svg" alt="">Send message</button>
					<div class="settings">
						<img src="/images/ci_settings.svg" alt="">
						<img src="/images/CaretDown.svg" alt="">
					</div>
				</div>

				<div class="container-2">
					<nav class="navbar">
						<ul class="links">
							<li><a href="/about" >About</a></li>
							<li><a href="/user-portfolio" class="active">Portfolio</a></li>
							<li><a href="/reviews">Reviews</a></li>
						</ul>
					</nav>
				</div>
				
			</div>
			
			<!-- Cards grid -->
			<section class="cards">
					<!-- Card 1 -->
					<div class="card">
							<div class="info">
									<img class="image-sample" src="/images/image (0).svg" alt="Priya Sharma"/>
							</div>
							<div class="group">
									<div class="card-text">
											<h2>Sleek Corset Dress</h2>
											<p>Fashion & Tailoring</p>
									</div>
							</div>
					</div>

					<div class="card">
							<div class="info">
									<img class="image-sample" src="/images/image (1).svg" alt="Priya Sharma"/>
							</div>
							<div class="group">
									<div class="card-text">
											<h2>Stylish Wedding Gown</h2>
											<p>Fashion & Tailoring</p>
									</div>
							</div>
					</div>

					<div class="card">
							<div class="info">
									<img class="image-sample" src="/images/image (2).svg" alt="Priya Sharma"/>
							</div>
							<div class="group">
									<div class="card-text">
											<h2>Sexy Dinner Gown</h2>
											<p>Fashion & Tailoring</p>
									</div>
							</div>
					</div>

					<div class="card">
							<div class="info">
									<img class="image-sample" src="/images/image (3).svg" alt="Priya Sharma"/>
							</div>
							<div class="group">
									<div class="card-text">
											<h2>Ankara Gown</h2>
											<p>Fashion & Tailoring</p>
									</div>
							</div>
					</div>

					<div class="card">
							<div class="info">
									<img class="image-sample" src="/images/image (4).svg" alt="Priya Sharma"/>
							</div>
							<div class="group">
									<div class="card-text">
											<h2>Custom suit & Pant</h2>
											<p>Fashion & Tailoring</p>
									</div>
							</div>
					</div>

					<div class="card">
							<div class="info">
									<img class="image-sample" src="/images/image (5).svg" alt="Priya Sharma"/>
							</div>
							<div class="group">
									<div class="card-text">
											<h2>Trendy Denim Pant</h2>
											<p>Fashion & Tailoring</p>
									</div>
							</div>
					</div>

			</section>
			
		</section>
	</div>
    
	<!-- Link to my Javascript file -->
	<script src="/js/exploreartisan2.js"></script>
</body>
</html>
